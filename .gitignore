*.mp3
*.wav
*.flac
*.ogg
*.m4a
*.aac
*.opus

# Documents
*.pdf
*.docx
*.doc
*.pptx
*.ppt
*.xlsx
*.xls

# Media
*.jpg
*.jpeg
*.png
*.gif
*.svg
*.ico
*.webp
*.mp4
*.mov
*.avi

# Archives
*.zip
*.tar.gz
*.tgz
*.rar
*.7z

# Local development
.terraform/
*.tfstate
*.tfstate.*
.terragrunt-cache/

# Serverless
.serverless/
.esbuild/
.webpack/

# Sentry
.sentry-native/

# Vercel
.vercel/

# Netlify
.netlify/

# PM2
.pm2/

# CI/CD
.github/
.gitlab/
.azure/
.circleci/
.drone.yml
.gitlab-ci.yml
.travis.yml

# Coverage reports
coverage/
cover/
.nyc_output/

# App-specific
local-data/
mock-feeds/
test-outputs/
scripts/temp/

# Documentation
docs/_build/
docs/html/
docs/latex/
site/

# Generated files
generated/
schema.graphql
graphql.schema.json
openapi.json
swagger.json

# Dependabot
.github/dependabot.yml

# ESLint/Prettier
.eslintcache
.stylelintcache
.prettierignore

# Miscellaneous
*.orig
*.rej
*.patch
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
.ftpconfig
.remote-sync.json

# Security sensitive
*.p12
*.pfx
*.jks
*.keystore
*.truststore
*.secret
*.secrets
secrets/
security/

# Ignore all mock data except for test-data directory
src/test-data/*
!src/test-data/mock-leads.json
!src/test-data/mock-zoning-context.txt
!src/test-data/mock-municipal-feeds/*.json
!src/test-data/expected-outputs.json

# Ignore but keep directory structure
logs/
dist/
!dist/.gitkeep
!logs/.gitkeep