# ============================================================
# FILE: .gitignore
# ============================================================

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# TypeScript
*.tsbuildinfo
dist/
build/
*.d.ts
*.js.map
*.js
!*.test.ts
!*.spec.ts
!*.config.js

# Environment variables
.env
.env.local
.env.*.local
.env.production
.env.development

# Logs
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.iml
.project
.classpath
.settings/

# Testing
coverage/
.nyc_output/
test-results/
jest-results.json
*.test.ts.snap

# Build artifacts
*.tmp
*.temp
.cache/
.eslintcache

# Docker
docker-compose.override.yml
*.dockerignore
Dockerfile.*.tmp

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# AWS
.aws/
credentials
config

# Secrets
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
*.truststore
*.secret
*.secrets
secrets/
security/

# Database
*.sqlite
*.db
*.db-journal
*.sqlite3
*.mdb
*.accdb

# Temporary files
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup

