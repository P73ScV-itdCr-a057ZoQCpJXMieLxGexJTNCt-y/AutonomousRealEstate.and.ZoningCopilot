# ============================================================
# FILE: .env.example
# ============================================================

# Application
NODE_ENV=development
PORT=3000
APP_NAME=Autonomous Real Estate Co-Pilot
APP_VERSION=1.0.0
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/realestate_copilot
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Redis (for caching and rate limiting)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL=3600

# AWS S3 (for audio storage)
AWS_REGION=us-west-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET=realestate-copilot-voicemails
S3_PREFIX=voicemails/
S3_EXPIRATION_SECONDS=3600

# MiniMax M3 API
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_API_URL=https://api.minimax.ai/v1/chat/completions
MINIMAX_MODEL=minimax_m3
MINIMAX_CONTEXT_WINDOW=1000000
MINIMAX_TEMPERATURE=0.2
MINIMAX_MAX_TOKENS=4096

# Cerebras (Ultra-fast inference)
CEREBRAS_API_KEY=your_cerebras_api_key
CEREBRAS_API_URL=https://api.cerebras.ai/v1/completions
CEREBRAS_MODEL=cerebras-llama3.1-8b
CEREBRAS_ENABLED=true
CEREBRAS_FALLBACK_THRESHOLD_MS=2000

# ElevenLabs (Text-to-Speech)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=pNInz6obpgmA513eg5Wx
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0.1
ELEVENLABS_USE_SPEAKER_BOOST=true

# Rtrvr.ai (Web Scraping)
RTRVR_API_KEY=your_rtrvr_api_key
RTRVR_API_URL=https://api.rtrvr.ai
RTRVR_MCP_URL=https://mcp.rtrvr.ai
RTRVR_TIMEOUT=60000
RTRVR_MAX_RETRIES=3

# Nexla (Data Transformation)
NEXLA_API_KEY=your_nexla_api_key
NEXLA_API_URL=https://api.nexla.com/v1
NEXLA_ENABLED=true
NEXLA_DATA_PRODUCT_PREFIX=zoning_

# Band (Collaboration)
BAND_API_KEY=your_band_api_key
BAND_API_URL=https://api.band.com/v1
BAND_DEFAULT_WORKSPACE=realestate-copilot
BAND_APPROVAL_TIMEOUT_MINUTES=1440

# Respan (Observability)
RESPAN_API_KEY=your_respan_api_key
RESPAN_ENDPOINT=https://respan.realestatecopilot.ai/api/v1/telemetry
RESPAN_LOG_LEVEL=debug
RESPAN_ENABLE_LIVE_DASHBOARD=true

# Compliance (TCPA/FCC)
COMPLIANCE_ENTITY_NAME=Land Equity Partners
COMPLIANCE_INCLUDE_AI_DISCLOSURE=true
COMPLIANCE_INCLUDE_OPT_OUT=true
COMPLIANCE_OPT_OUT_KEY=9
COMPLIANCE_OPT_OUT_PHRASE=stop
COMPLIANCE_OPT_OUT_PHONE=1-800-555-0199
COMPLIANCE_DNC_REGISTRATION_PHONE=1-888-555-0199

# Security
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Cron Jobs
CRON_DAILY_SCAN=0 6 * * *
CRON_COMPLIANCE_AUDIT=0 0 * * 0
CRON_QUALITY_REPORT=0 8 * * 1

# Feature Flags
FEATURE_ENABLE_MOCK_DATA=true
FEATURE_ENABLE_AUDIO_GENERATION=true
FEATURE_ENABLE_EQUITY_ANALYSIS=true
FEATURE_ENABLE_TCPA_COMPLIANCE=true
FEATURE_ENABLE_BAND_COLLABORATION=true
FEATURE_ENABLE_RESPAN_TELEMETRY=true

# Performance
PERFORMANCE_CACHE_ENABLED=true
PERFORMANCE_CACHE_TTL_SECONDS=3600
PERFORMANCE_PARALLEL_BATCH_SIZE=10
PERFORMANCE_MAX_CONCURRENT_BATCHES=5

# Deployment
DEPLOYMENT_ENVIRONMENT=development
DEPLOYMENT_REGION=us-west-1
DEPLOYMENT_INSTANCE_TYPE=starter
DEPLOYMENT_MIN_INSTANCES=1
DEPLOYMENT_MAX_INSTANCES=3