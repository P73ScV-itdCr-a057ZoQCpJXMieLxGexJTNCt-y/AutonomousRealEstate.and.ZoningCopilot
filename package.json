{
  "name": "autonomous-real-estate-copilot",
  "version": "1.0.0",
  "description": "AI-powered autonomous real estate development and zoning co-pilot with multi-agent orchestration",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc && npm run copy:assets",
    "copy:assets": "cp -r src/prompts src/config/*.json src/templates dist/ 2>/dev/null || echo 'Assets copied'",
    "start": "node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "pipeline:run": "ts-node src/pipeline-orchestrator.ts",
    "pipeline:mock": "ts-node src/pipeline-orchestrator.ts --mock",
    "pipeline:test": "ts-node src/pipeline-orchestrator.ts --test",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=tests/integration",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist logs/*",
    "generate:voicemail": "ts-node scripts/generate-voicemail.ts",
    "audit:compliance": "ts-node scripts/compliance-audit.ts",
    "seed:parcels": "ts-node scripts/seed-parcels.ts",
    "db:migrate": "ts-node scripts/db-migrate.ts",
    "db:seed": "ts-node scripts/db-seed.ts",
    "deploy:render": "ts-node scripts/deploy-render.ts",
    "deploy:docker": "docker build -t realestate-copilot . && docker-compose up -d",
    "health": "curl http://localhost:3000/health | json_pp",
    "logs": "tail -f logs/app.log",
    "docker:build": "docker build -t realestate-copilot .",
    "docker:run": "docker-compose up",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "ai",
    "real-estate",
    "zoning",
    "autonomous-agents",
    "multi-agent",
    "prompt-driven-development",
    "minimax",
    "elevenlabs",
    "rocketride",
    "nexla",
    "rtrvr"
  ],
  "author": "Autonomous Real Estate Co-Pilot Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.540.0",
    "@aws-sdk/s3-request-presigner": "^3.540.0",
    "@types/node-fetch": "^2.6.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "node-fetch": "^2.7.0",
    "pg": "^8.11.3",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "rate-limiter-flexible": "^3.0.0",
    "slugify": "^1.6.6",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.8.6",
    "@types/node-cron": "^3.0.10",
    "@types/pg": "^8.10.7",
    "@types/uuid": "^9.0.5",
    "@typescript-eslint/eslint-plugin": "^6.8.0",
    "@typescript-eslint/parser": "^6.8.0",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}